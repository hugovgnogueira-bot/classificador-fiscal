  "_orientacao_novos_tipos": {
    "descricao": "Tipos de item particulares de cada empresa, como Materia-Prima, Insumos, Embalagens, Produto Acabado e Mercadoria para Revenda, nao fazem parte deste modelo. Para incluir, crie um novo tipo dentro de 'tipos' seguindo a mesma estrutura e informe a natureza (Produto ou Servico). Este bloco e ignorado pelo notebook.",
    "numeracao_sugerida": "Os numeros 3 a 8 ficam livres para os tipos da empresa.",
    "exemplo": {
      "3. Materia-Prima": {
        "natureza": "Produto",
        "descricao": "Materiais que se incorporam ao produto final.",
        "grupos": {
          "1. <Nome do grupo>": {
            "subgrupos": {
              "1. <Nome do subgrupo>": {
                "classes": {
                  "Producao (C.I.)": {
                    "conta_ref": "31",
                    "mascara_ref": "1.1.3.03.001"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
