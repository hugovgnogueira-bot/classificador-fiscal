{
  "regras_imobilizacao": {
    "descricao": "Criterios para decidir se um item deve ser imobilizado (Ativo) ou lancado como despesa/custo, conforme CPC 27 / NBC TG 27 e o limite fiscal de deducao do art. 15 do Decreto-Lei 1.598/1977, com redacao da Lei 12.973/2014.",
    "limite_valor_reais": 1200.0,
    "vida_util_minima_meses": 12,
    "criterios": [
      "Valor unitario acima do limite de R$ 1.200,00",
      "Vida util superior a 12 meses",
      "Gera beneficio economico futuro para a empresa",
      "Nao e item de consumo ou reposicao imediata"
    ],
    "destino_se_imobilizar": {
      "Produto": "1. Imobilizado",
      "Servico": "9. Servicos > 14. Imobilizados"
    },
    "destino_se_nao_imobilizar": {
      "Produto": "2. Uso e Consumo (bens duraveis abaixo do limite vao para 4. Bens Duraveis de Pequeno Valor). Se a compra entra no almoxarifado, use a classe Estoque; se e consumo imediato, use a classe do setor.",
      "Servico": "9. Servicos, no grupo e na classe do setor que consome o servico"
    },
    "observacao": "Se o item atende TODOS os criterios acima, vai para o destino de imobilizacao conforme a natureza (Produto ou Servico). Caso contrario, segue a classificacao normal de despesa/custo. Itens de consumo, pecas de reposicao comuns e materiais de uso continuo sao despesa independente do valor."
  },
